<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settings_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/g_paper"
    android:clipToPadding="false"
    android:paddingHorizontal="18dp"
    android:paddingTop="16dp"
    android:paddingBottom="76dp">

<FrameLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/settings_page_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/G.PageTitle"
            android:text="设置" />

        <TextView
            android:id="@+id/tv_settings_status_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="monospace"
            android:text=""
            android:textColor="@color/g_sub"
            android:textSize="12sp" />

        <TextView
            style="@style/G.SectionLabel"
            android:text="ACCOUNT · 账号" />
        <com.google.android.material.card.MaterialCardView
            style="@style/G.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="教务账号"
                        android:textColor="@color/g_ink"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_settings_node_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:paddingVertical="3dp"
                        android:text="○ 待连接"
                        android:textColor="@color/g_mute"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/host_status_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="首次使用请登录统一门户；之后课表与成绩可静默更新"
                    android:textColor="@color/g_sub"
                    android:textSize="12.5sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_settings_sync_now"
                        style="@style/Gauge.Button"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:text="同步课表"
                        android:textSize="12.5sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_settings_open_portal"
                        style="@style/Gauge.Button.Outline"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:text="登录统一门户"
                        android:textSize="12.5sp" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/G.SectionLabel"
            android:text="ENTRIES · 入口" />
        <com.google.android.material.card.MaterialCardView
            style="@style/G.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <LinearLayout
                android:id="@+id/card_settings_grades"
                style="@style/G.Row">

                <TextView
                    style="@style/G.RowIndex"
                    android:text="01" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/G.RowTitle"
                        android:text="学业成绩" />

                    <TextView
                        android:id="@+id/tv_settings_grade_summary"
                        style="@style/G.RowSub"
                        android:text="GPA —  ·  加权 —" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_settings_grade_new"
                    style="@style/G.RowChevron" />
            </LinearLayout>

            <View style="@style/G.Hair" />

            <LinearLayout
                android:id="@+id/row_settings_campus"
                style="@style/G.Row">

                <TextView
                    style="@style/G.RowIndex"
                    android:text="02" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/G.RowTitle"
                        android:text="校园" />

                    <TextView
                        style="@style/G.RowSub"
                        android:text="校历 · 地图 · 图书馆 · 邮箱" />
                </LinearLayout>

                <TextView
                    style="@style/G.RowChevron" />
            </LinearLayout>

            <View style="@style/G.Hair" />

            <LinearLayout
                android:id="@+id/row_settings_classmates"
                style="@style/G.Row">

                <TextView
                    style="@style/G.RowIndex"
                    android:text="03" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/G.RowTitle"
                        android:text="同学" />

                    <TextView
                        style="@style/G.RowSub"
                        android:text="分享课表 · 共同空闲" />
                </LinearLayout>

                <TextView
                    style="@style/G.RowChevron" />
            </LinearLayout>

            <View style="@style/G.Hair" />

            <LinearLayout
                android:id="@+id/row_settings_timetable_page"
                style="@style/G.Row">

                <TextView
                    style="@style/G.RowIndex"
                    android:text="04" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/G.RowTitle"
                        android:text="课表与作息" />

                    <TextView
                        android:id="@+id/tv_settings_tt_page_sub"
                        style="@style/G.RowSub"
                        android:text="作息时间 · 显示规则 · 导入导出" />
                </LinearLayout>

                <TextView
                    style="@style/G.RowChevron" />
            </LinearLayout>

            <View style="@style/G.Hair" />

            <LinearLayout
                android:id="@+id/row_settings_general_page"
                style="@style/G.Row">

                <TextView
                    style="@style/G.RowIndex"
                    android:text="05" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/G.RowTitle"
                        android:text="通用" />

                    <TextView
                        style="@style/G.RowSub"
                        android:text="外观 · 数据 · 关于" />
                </LinearLayout>

                <TextView
                    style="@style/G.RowChevron" />
            </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
    <LinearLayout
        android:id="@+id/settings_page_timetable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/btn_settings_back_tt"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="-6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center_vertical"
            android:paddingHorizontal="6dp"
            android:fontFamily="monospace"
            android:text="‹ 设置"
            android:textColor="@color/g_sub"
            android:textSize="13sp" />

        <TextView
            style="@style/G.PageTitle"
            android:layout_marginTop="4dp"
            android:text="课表与作息" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="课表怎么显示、几点上课、数据进出"
            android:textColor="@color/g_sub"
            android:textSize="12.5sp" />
        <TextView
            style="@style/G.SectionLabel"
            android:text="DISPLAY · 显示" />
        <com.google.android.material.card.MaterialCardView
            style="@style/G.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <LinearLayout
                android:id="@+id/card_settings_timetable"
                style="@style/G.Row">

                <TextView
                    style="@style/G.RowIndex"
                    android:text="01" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/G.RowTitle"
                        android:text="课表设置" />

                    <TextView
                        android:id="@+id/tv_settings_timetable_summary"
                        style="@style/G.RowSub"
                        android:text="七天模式" />
                </LinearLayout>

                <TextView
                    style="@style/G.RowChevron" />
            </LinearLayout>

            <View style="@style/G.Hair" />

            <LinearLayout
                android:id="@+id/card_settings_schedule"
                style="@style/G.Row">

                <TextView
                    style="@style/G.RowIndex"
                    android:text="02" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/G.RowTitle"
                        android:text="作息时间" />

                    <TextView
                        android:id="@+id/tv_settings_schedule_summary"
                        style="@style/G.RowSub"
                        android:text="第 1 节 08:00 开始 · 每节 45 分钟" />
                </LinearLayout>

                <TextView
                    style="@style/G.RowChevron" />
            </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/G.SectionLabel"
            android:text="IN / OUT · 导入导出" />
        <com.google.android.material.card.MaterialCardView
            style="@style/G.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <LinearLayout
                android:id="@+id/row_export_ics"
                style="@style/G.Row">

                <TextView
                    style="@style/G.RowIndex"
                    android:text="01" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/G.RowTitle"
                        android:text="导出到手机日历" />

                    <TextView
                        android:id="@+id/tv_ics_sub"
                        style="@style/G.RowSub"
                        android:text="生成 .ics，系统日历或 WPS 都能打开" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="ICS"
                    android:textColor="@color/g_mute"
                    android:textSize="11sp" />
            </LinearLayout>

            <View style="@style/G.Hair" />

            <LinearLayout
                android:id="@+id/btn_export_timetable"
                style="@style/G.Row">

                <TextView
                    style="@style/G.RowIndex"
                    android:text="02" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/G.RowTitle"
                        android:text="备份课表" />

                    <TextView
                        android:id="@+id/tv_export_sub"
                        style="@style/G.RowSub"
                        android:text="导出 JSON 文件，换机或分享" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="JSON"
                    android:textColor="@color/g_mute"
                    android:textSize="11sp" />
            </LinearLayout>

            <View style="@style/G.Hair" />

            <LinearLayout
                android:id="@+id/btn_import_timetable"
                style="@style/G.Row">

                <TextView
                    style="@style/G.RowIndex"
                    android:text="03" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/G.RowTitle"
                        android:text="从备份导入" />

                    <TextView
                        android:id="@+id/tv_import_sub"
                        style="@style/G.RowSub"
                        android:text="选择 JSON 文件合并进当前课表" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="JSON"
                    android:textColor="@color/g_mute"
                    android:textSize="11sp" />
            </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
    <LinearLayout
        android:id="@+id/settings_page_general"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/btn_settings_back_general"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="-6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center_vertical"
            android:paddingHorizontal="6dp"
            android:fontFamily="monospace"
            android:text="‹ 设置"
            android:textColor="@color/g_sub"
            android:textSize="13sp" />

        <TextView
            style="@style/G.PageTitle"
            android:layout_marginTop="4dp"
            android:text="通用" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="外观、本地数据与高级选项"
            android:textColor="@color/g_sub"
            android:textSize="12.5sp" />
        <TextView
            style="@style/G.SectionLabel"
            android:text="APPEARANCE · 外观" />
        <com.google.android.material.card.MaterialCardView
            style="@style/G.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/G.RowTitle"
                    android:text="深色模式" />

                <LinearLayout
                    android:id="@+id/seg_night_mode"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/G.SectionLabel"
            android:text="NOTIFY · 通知" />
        <com.google.android.material.card.MaterialCardView
            style="@style/G.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/G.RowTitle"
                            android:text="出新成绩时提醒" />

                        <TextView
                            style="@style/G.RowSub"
                            android:text="后台约每 6 小时用已登录的门户查一次" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_grade_notify"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/G.SectionLabel"
            android:text="DATA · 本地数据" />
        <com.google.android.material.card.MaterialCardView
            style="@style/G.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/tv_settings_data_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="本地课表：0 门  ·  成绩：0 门"
                    android:textColor="@color/g_sub"
                    android:textSize="12.5sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_seed_demo_all"
                    android:visibility="gone"
                        style="@style/Gauge.Button.Outline"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:text="载入演示数据"
                        android:textSize="12.5sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_clear_local_data"
                        style="@style/Gauge.Button.Outline"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:text="清空本地数据"
                        android:textColor="@color/g_accent"
                        android:textSize="12.5sp" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/G.SectionLabel"
            android:text="ADVANCED · 高级" />
        <com.google.android.material.card.MaterialCardView
            style="@style/G.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <LinearLayout
                android:id="@+id/btn_edit_targets"
                style="@style/G.Row">

                <TextView
                    style="@style/G.RowIndex"
                    android:text="01" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/G.RowTitle"
                        android:text="教务接口路径" />

                    <TextView
                        style="@style/G.RowSub"
                        android:text="节点或接口变了才需要改" />
                </LinearLayout>

                <TextView
                    style="@style/G.RowChevron" />
            </LinearLayout>

            <View style="@style/G.Hair" />

            <LinearLayout
                android:id="@+id/btn_reset_targets"
                style="@style/G.Row">

                <TextView
                    style="@style/G.RowIndex"
                    android:text="02" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/G.RowTitle"
                        android:text="重置节点与默认配置" />

                    <TextView
                        style="@style/G.RowSub"
                        android:text="清除记住的代理节点" />
                </LinearLayout>

                <TextView
                    style="@style/G.RowChevron" />
            </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/G.SectionLabel"
            android:text="ABOUT · 关于" />
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_about"
            style="@style/G.Card"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/tv_about_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/g_ink"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="烫梨 · v0.4" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="非官方校园工具。教务数据以学校系统为准，成绩计算仅供参考。不保存任何账号密码。"
                    android:textColor="@color/g_mute"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_about_star"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="?attr/selectableItemBackground"
                    android:paddingVertical="4dp"
                    android:text="★ 觉得好用？去 GitHub 点个 Star，让更多同学找到它"
                    android:textColor="@color/g_ink"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_about_more"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="monospace"
                    android:text="项目主页 · 检查更新 · 问题反馈  ›"
                    android:textColor="@color/g_ink"
                    android:textSize="12sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</FrameLayout>
</ScrollView>
